{
  "name": "provira",
  "private": true,
  "version": "0.1.0",
  "description": "Provira — economic identity infrastructure for Nigeria's informal economy",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @provira/db generate",
    "db:migrate": "pnpm --filter @provira/db migrate",
    "db:seed": "pnpm --filter @provira/db seed",
    "db:studio": "pnpm --filter @provira/db studio"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "prettier": "^3.3.3"
  }
}
