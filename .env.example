# Copy to .env for local dev. Docker-compose reads these too.
NODE_ENV=development

# Postgres (docker-compose service name is "postgres")
DATABASE_URL=postgresql://tally:tally@localhost:5432/tally?schema=public

# Redis (docker-compose service name is "redis")
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
JWT_SECRET=dev-only-change-me
OTP_TTL_SECONDS=300

# Admin network allowlist (defence in depth for the back-office surface).
# Comma-separated IPs/CIDRs. Enforced at the API guard AND the admin edge
# middleware. Leave unset or "*" to allow all (dev). Example:
# ADMIN_IP_ALLOWLIST=10.0.0.0/8,203.0.113.5

# Integration adapters. "mock" keeps everything runnable with NO real keys.
PAYMENTS_PROVIDER=mock
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
LLM_PROVIDER=mock

# Real provider keys (unused while *_PROVIDER=mock)
# PAYSTACK_SECRET_KEY=
# TERMII_API_KEY=
# WHATSAPP_TOKEN=
# OPENAI_API_KEY=
