# Copy to .env for local dev. Docker-compose reads these too.
NODE_ENV=development

# Postgres (docker-compose service name is "postgres")
DATABASE_URL=postgresql://tally:tally@localhost:5432/tally?schema=public

# Redis (docker-compose service name is "redis")
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
JWT_SECRET=dev-only-change-me
OTP_TTL_SECONDS=300

# Admin network allowlist (defence in depth for the back-office surface).
# Comma-separated IPs/CIDRs. Enforced at the API guard AND the admin edge
# middleware. Leave unset or "*" to allow all (dev). Example:
# ADMIN_IP_ALLOWLIST=10.0.0.0/8,203.0.113.5

# Integration adapters. "mock" keeps everything runnable with NO real keys.
PAYMENTS_PROVIDER=mock
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
EMAIL_PROVIDER=mock
PUSH_PROVIDER=mock
LLM_PROVIDER=mock

# Object storage for document/file uploads. "mock" writes to local disk and
# serves files back through the API. Swap for s3/gcs in production.
STORAGE_PROVIDER=mock
# STORAGE_DIR=/var/lib/tally-storage      # mock only; defaults to <tmp>/tally-storage
# PUBLIC_API_URL=http://localhost:4000/api # base for stored-file URLs

# Squad (squadco) — set PAYMENTS_PROVIDER=squad to use it. Defaults to sandbox.
# SQUAD_SECRET_KEY=sandbox_sk_xxxxxxxx
# SQUAD_MERCHANT_ID=SBXXXXXX            # transfer refs are prefixed with this
# SQUAD_BASE_URL=https://sandbox-api-d.squadco.com   # omit = sandbox; prod: https://api-d.squadco.com
# SQUAD_PUBLIC_KEY=sandbox_pk_xxxxxxxx  # only needed for dynamic-VA encryption
# Webhook URL (set in Squad dashboard): https://<api-host>/api/payments/webhook

# Other real provider keys (unused while *_PROVIDER=mock)
# TERMII_API_KEY=
# WHATSAPP_TOKEN=
# OPENAI_API_KEY=
