// Tally — economic identity infrastructure for Nigeria's informal economy
// Prisma schema (STAGE 1 — for review before backend scaffolding)
//
// Conventions:
// - All money is stored as BigInt in the currency's MINOR unit (kobo for NGN).
//   Never floats. currency defaults to NGN.
// - Every user-facing string that can be localized is resolved at the channel
//   layer, not stored per-row; we store a `language` preference on the user.
// - Financial movements go through a minimal double-entry ledger
//   (Account + LedgerTransaction + LedgerEntry). Wallet/escrow balances are
//   cached on Account.balance and must always equal the sum of their entries.
// - Third-party providers (payments, whatsapp, sms/voice, llm) are NOT modeled
//   here — they live behind adapter interfaces. We only persist the artifacts
//   they produce (PaymentIntent, InboundMessage, etc.).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Language {
  EN // English
  PCM // Nigerian Pidgin
  YO // Yoruba
  HA // Hausa
  IG // Igbo
}

enum RoleType {
  WORKER
  TRADER
  EMPLOYER
}

enum UserStatus {
  PENDING // signed up, not yet verified
  ACTIVE
  SUSPENDED
}

enum KycLevel {
  NONE
  BASIC // phone + name
  BVN_VERIFIED // BVN/NIN checked — required for higher payout/loan limits
  FULL
}

enum Channel {
  WEB
  WHATSAPP
  SMS
  IVR // phone call / DTMF
  USSD // reserved for future
}

// --- Jobs ---

enum JobStatus {
  DRAFT
  OPEN // published, accepting/matching workers
  FILLED // worker assigned, escrow funded
  IN_PROGRESS
  COMPLETED // attendance confirmed, pay released
  CANCELLED
  EXPIRED
}

enum AssignmentStatus {
  MATCHED // surfaced by matching engine (not persisted; suggestion only)
  INVITED // employer invited the worker — awaiting the worker's acceptance
  APPLIED // worker applied — awaiting the employer's acceptance
  ACCEPTED // in the job: employer accepted an application, or worker accepted an invite
  DECLINED
  WITHDRAWN
  CONFIRMED // attendance confirmed via code
  COMPLETED
  NO_SHOW
}

enum AttendanceStatus {
  PENDING
  CONFIRMED
  DISPUTED
  NO_SHOW
}

// --- Ledger / payments ---

enum AccountType {
  EMPLOYER_FUNDING // employer's top-up wallet
  JOB_ESCROW // per-job holding account
  WORKER_PAYOUT // worker's balance / payout wallet
  TRADER_SETTLEMENT // trader's settlement wallet
  PLATFORM_FEE
  PLATFORM_CASH // Tally's own cash / lending pool
  LOAN_RECEIVABLE // outstanding loan principal owed to Tally
  SUSPENSE // external-in/out clearing
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum LedgerTxnType {
  ESCROW_FUND
  ESCROW_RELEASE
  ESCROW_REFUND
  PAYOUT
  WITHDRAWAL
  TRADER_SETTLEMENT
  FEE
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  ADJUSTMENT
}

enum LedgerTxnStatus {
  PENDING
  POSTED
  FAILED
  REVERSED
}

enum PaymentDirection {
  INBOUND // money into Tally (employer funding, card sale)
  OUTBOUND // money out of Tally (worker payout, loan disbursement)
}

enum PaymentStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  REVERSED
}

// --- Scoring ---

enum ScoreTier {
  BUILDING
  EMERGING
  TRUSTED
  ESTABLISHED
}

enum ScoreEventType {
  JOB_COMPLETED
  JOB_ON_TIME
  JOB_NO_SHOW
  SALE_LOGGED
  LOAN_REPAID_ON_TIME
  LOAN_DEFAULT
  DISPUTE_RAISED
  MANUAL_ADJUSTMENT
}

// --- Lending ---

enum LoanApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum LoanStatus {
  ACTIVE
  REPAID
  DELINQUENT
  DEFAULTED
  WRITTEN_OFF
}

enum RepaymentStatus {
  SCHEDULED
  PAID
  PARTIAL
  MISSED
  WAIVED
}

// ---------------------------------------------------------------------------
// Identity & auth
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  phone         String     @unique // E.164, the primary identifier
  email         String?    @unique // rare for this user base
  fullName      String?
  language      Language   @default(EN)
  status        UserStatus @default(PENDING)
  kycLevel      KycLevel   @default(NONE)
  bvnHash       String? // hashed BVN/NIN, never stored raw
  hasSmartphone Boolean    @default(false) // drives channel defaults
  // Which jobs the worker's feed surfaces: ALL, SKILLS (matched to their skills),
  // or NEARBY (same state). Free-form string so it stays trivial to migrate.
  jobFeed       String     @default("ALL")

  // Verified payout destination (where the user receives funds). The account
  // name is resolved via the payment provider's account lookup, not typed.
  payoutBankCode      String?
  payoutBankName      String?
  payoutAccountNumber String?
  payoutAccountName   String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  roles           UserRole[]
  workerProfile   WorkerProfile?
  traderProfile   TraderProfile?
  employerProfile EmployerProfile?

  channelIdentities   ChannelIdentity[]
  otpChallenges       OtpChallenge[]
  accounts            Account[]
  scoreProfile        ScoreProfile?
  scoreEvents         ScoreEvent[]
  loanApplications    LoanApplication[]
  loans               Loan[]
  inboundMessages     InboundMessage[]
  conversations       ConversationState[]
  reportedDisputes    Dispute[]            @relation("DisputeReporter")
  disputesAgainst     Dispute[]            @relation("DisputeDefendant")
  impersonationGrants ImpersonationGrant[]

  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  notificationSetting NotificationSetting?
  pushDevices         PushDevice[]
  verificationRequests VerificationRequest[]

  @@index([status])
}

// A user may hold more than one role over time (e.g. worker who also trades).
model UserRole {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     RoleType
  isActive Boolean  @default(true)
  addedAt  DateTime @default(now())

  @@unique([userId, role])
  @@index([role])
}

// Maps an external channel identity (whatsapp id, msisdn, caller id) to a user.
model ChannelIdentity {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    Channel
  externalId String // whatsapp wa_id / phone number / caller id
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([channel, externalId])
  @@index([userId])
}

// OTP challenge for phone-first auth. Codes stored hashed, short TTL.
model OtpChallenge {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone       String
  codeHash    String
  channel     Channel   @default(SMS)
  purpose     String    @default("login") // login | signup | payout_confirm
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone, purpose])
}

// ---------------------------------------------------------------------------
// Role profiles
// ---------------------------------------------------------------------------

model WorkerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills      WorkerSkill[]
  languages   Language[] // languages the worker speaks
  location    Location?       @relation(fields: [locationId], references: [id])
  locationId  String?
  assignments JobAssignment[]

  @@index([locationId])
}

model TraderProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String?
  marketName   String?
  location     Location? @relation(fields: [locationId], references: [id])
  locationId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sales SaleRecord[]

  @@index([locationId])
}

model EmployerProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String?
  location     Location? @relation(fields: [locationId], references: [id])
  locationId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  jobs Job[]

  @@index([locationId])
}

// ---------------------------------------------------------------------------
// Reference data: skills & locations
// ---------------------------------------------------------------------------

model Skill {
  id      String        @id @default(cuid())
  slug    String        @unique // e.g. "bricklaying", "tailoring"
  name    String
  workers WorkerSkill[]
  jobs    JobSkill[]
}

model WorkerSkill {
  id       String        @id @default(cuid())
  workerId String
  worker   WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skillId  String
  skill    Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  yearsExp Int           @default(0)

  @@unique([workerId, skillId])
}

// Lightweight geo model; lat/lng enable radius matching without PostGIS for now.
model Location {
  id        String   @id @default(cuid())
  label     String? // "Balogun Market", "Ikeja"
  state     String? // Lagos, Kano...
  lga       String? // local government area
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  workers   WorkerProfile[]
  traders   TraderProfile[]
  employers EmployerProfile[]
  jobs      Job[]
}

// ---------------------------------------------------------------------------
// Job marketplace
// ---------------------------------------------------------------------------

model Job {
  id          String          @id @default(cuid())
  employerId  String
  employer    EmployerProfile @relation(fields: [employerId], references: [id])
  title       String
  description String?
  status      JobStatus       @default(DRAFT)
  payAmount   BigInt // kobo, total pay for the job
  currency    String          @default("NGN")
  locationId  String?
  location    Location?       @relation(fields: [locationId], references: [id])
  languages   Language[] // languages acceptable for the job
  startAt     DateTime?
  endAt       DateTime?
  headcount   Int             @default(1) // number of workers needed
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  skills      JobSkill[]
  assignments JobAssignment[]
  escrow      EscrowAccount?
  attendances Attendance[]

  @@index([status])
  @@index([locationId])
  @@index([employerId])
}

model JobSkill {
  id      String @id @default(cuid())
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
}

// One row per worker considered/assigned to a job. Carries the match score.
model JobAssignment {
  id         String           @id @default(cuid())
  jobId      String
  job        Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId   String
  worker     WorkerProfile    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  status     AssignmentStatus @default(MATCHED)
  matchScore Float? // ranking score from matching engine
  invitedAt  DateTime? // set when the employer invites this worker
  appliedAt  DateTime? // set when the worker applies
  acceptedAt DateTime? // set when the worker joins the job (either path)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  attendance Attendance?

  @@unique([jobId, workerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Attendance & confirmation code
// ---------------------------------------------------------------------------

model Attendance {
  id              String           @id @default(cuid())
  jobId           String
  job             Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assignmentId    String           @unique
  assignment      JobAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  status          AttendanceStatus @default(PENDING)
  confirmCodeHash String // 4-digit code, hashed; used to verify confirmation
  code            String? // same 4-digit code in the clear, so the employer can show it on site
  confirmedAt     DateTime?
  confirmedVia    Channel?
  createdAt       DateTime         @default(now())

  @@index([status])
}

// ---------------------------------------------------------------------------
// Ledger, escrow & payments
// ---------------------------------------------------------------------------

model Account {
  id        String      @id @default(cuid())
  type      AccountType
  ownerId   String? // userId for user wallets; null for platform accounts
  owner     User?       @relation(fields: [ownerId], references: [id])
  currency  String      @default("NGN")
  balance   BigInt      @default(0) // cached kobo balance; = sum of entries
  createdAt DateTime    @default(now())

  entries LedgerEntry[]
  escrow  EscrowAccount?

  @@index([type])
  @@index([ownerId])
}

model EscrowAccount {
  id         String    @id @default(cuid())
  jobId      String    @unique
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  accountId  String    @unique
  account    Account   @relation(fields: [accountId], references: [id])
  amount     BigInt // required funding amount, kobo
  currency   String    @default("NGN")
  fundedAt   DateTime?
  releasedAt DateTime?
  refundedAt DateTime?
  createdAt  DateTime  @default(now())
}

// A balanced group of ledger entries. Sum of DEBITs == sum of CREDITs.
model LedgerTransaction {
  id             String          @id @default(cuid())
  type           LedgerTxnType
  status         LedgerTxnStatus @default(PENDING)
  reference      String? // human-readable ref
  idempotencyKey String?         @unique // prevents double-posting
  metadata       Json?
  createdAt      DateTime        @default(now())
  postedAt       DateTime?

  entries  LedgerEntry[]
  payments PaymentIntent[]
}

model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account           @relation(fields: [accountId], references: [id])
  direction     EntryDirection
  amount        BigInt // kobo, always positive
  createdAt     DateTime          @default(now())

  @@index([accountId])
  @@index([transactionId])
}

// Artifact of a provider-neutral PaymentProvider adapter call. Links external
// money movement (funding, payout, disbursement) to an internal ledger txn.
model PaymentIntent {
  id             String             @id @default(cuid())
  direction      PaymentDirection
  status         PaymentStatus      @default(CREATED)
  amount         BigInt // kobo
  currency       String             @default("NGN")
  provider       String // adapter name, e.g. "mock", "paystack"
  providerRef    String? // provider-side transaction id
  idempotencyKey String?            @unique
  transactionId  String?
  transaction    LedgerTransaction? @relation(fields: [transactionId], references: [id])
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  webhookEvents PaymentWebhookEvent[]

  @@index([status])
  @@index([providerRef])
}

// Raw inbound webhook from a payment provider, stored for audit/idempotency.
model PaymentWebhookEvent {
  id              String         @id @default(cuid())
  provider        String
  eventType       String
  providerEventId String?        @unique
  paymentIntentId String?
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id])
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Trader sales
// ---------------------------------------------------------------------------

model SaleRecord {
  id         String        @id @default(cuid())
  traderId   String
  trader     TraderProfile @relation(fields: [traderId], references: [id], onDelete: Cascade)
  amount     BigInt // kobo
  currency   String        @default("NGN")
  method     String        @default("card") // card | cash | transfer
  reference  String? // POS/provider reference
  occurredAt DateTime      @default(now())
  createdAt  DateTime      @default(now())

  @@index([traderId])
  @@index([occurredAt])
}

// ---------------------------------------------------------------------------
// Reliability score engine
// ---------------------------------------------------------------------------

// Current score snapshot per user (fast reads for gating). Recomputed by the
// scoring worker from the append-only ScoreEvent log.
model ScoreProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  score          Int       @default(0) // 0..1000 (tunable range)
  tier           ScoreTier @default(BUILDING)
  jobsCompleted  Int       @default(0)
  onTimeRate     Float     @default(0) // 0..1
  salesCount     Int       @default(0)
  lastComputedAt DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Append-only log of scoring signals. The engine is a pure function of these.
model ScoreEvent {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ScoreEventType
  weight    Float          @default(0) // delta contribution, set by engine config
  refType   String? // "job" | "loan" | "sale"
  refId     String?
  metadata  Json?
  createdAt DateTime       @default(now())

  @@index([userId])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Micro-lending (Tally as lender of record, behind a Lender abstraction)
// ---------------------------------------------------------------------------

model Lender {
  id         String   @id @default(cuid())
  name       String
  isPlatform Boolean  @default(true) // Tally itself vs a partner lender
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  products         LoanProduct[]
  loans            Loan[]
  loanApplications LoanApplication[]
}

model LoanProduct {
  id          String    @id @default(cuid())
  lenderId    String
  lender      Lender    @relation(fields: [lenderId], references: [id])
  name        String
  minAmount   BigInt // kobo
  maxAmount   BigInt // kobo
  interestBps Int // interest in basis points for the term
  termDays    Int
  minScore    Int // score threshold to qualify
  minTier     ScoreTier @default(EMERGING)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  applications LoanApplication[]
  loans        Loan[]
}

model LoanApplication {
  id             String                @id @default(cuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id])
  productId      String
  product        LoanProduct           @relation(fields: [productId], references: [id])
  lenderId       String
  lender         Lender                @relation(fields: [lenderId], references: [id])
  amount         BigInt // requested, kobo
  status         LoanApplicationStatus @default(SUBMITTED)
  scoreAtApply   Int? // snapshot for audit
  decisionReason String?
  decidedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  loan Loan?

  @@index([userId])
  @@index([status])
}

model Loan {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  lenderId      String
  lender        Lender           @relation(fields: [lenderId], references: [id])
  productId     String
  product       LoanProduct      @relation(fields: [productId], references: [id])
  applicationId String?          @unique
  application   LoanApplication? @relation(fields: [applicationId], references: [id])
  principal     BigInt // kobo
  interestBps   Int
  currency      String           @default("NGN")
  status        LoanStatus       @default(ACTIVE)
  disbursedAt   DateTime?
  dueAt         DateTime?
  closedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  repayments RepaymentInstallment[]

  @@index([userId])
  @@index([status])
}

model RepaymentInstallment {
  id         String          @id @default(cuid())
  loanId     String
  loan       Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)
  sequence   Int // 1..n
  dueAt      DateTime
  amountDue  BigInt // kobo (principal + interest portion)
  amountPaid BigInt          @default(0)
  status     RepaymentStatus @default(SCHEDULED)
  paidAt     DateTime?

  @@unique([loanId, sequence])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Multi-channel messaging (bot / SMS / IVR)
// ---------------------------------------------------------------------------

// Persisted inbound message from any channel, after adapter normalization.
model InboundMessage {
  id               String    @id @default(cuid())
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel          Channel
  externalId       String? // sender's channel id
  rawBody          String? // text, transcript, or DTMF sequence
  detectedLanguage Language?
  intent           String? // resolved by LLM/NLU adapter, e.g. "accept_job"
  metadata         Json?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([channel])
}

// Tracks a multi-step conversation/IVR flow state per user+channel.
model ConversationState {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel    Channel
  externalId String
  flow       String // "signup" | "accept_job" | "confirm_attendance"
  step       String
  context    Json? // accumulated slot values
  expiresAt  DateTime?
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())

  @@unique([channel, externalId])
  @@index([userId])
}

// ===========================================================================
// ADMIN / BACK-OFFICE — RBAC, audit, disputes
// ===========================================================================

enum AdminStatus {
  INVITED
  ACTIVE
  DISABLED
}

// A permission is a "resource:action" string (e.g. "finance:approve_withdrawals").
// Nothing is hardcoded — roles are just bundles of these.
model Permission {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "users:suspend"
  group     String // e.g. "Users" (for grouping in the UI)
  label     String // e.g. "Suspend"
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([group])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // system roles (e.g. Super Admin) can't be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  admins      AdminUserRole[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AdminUser {
  id           String      @id @default(cuid())
  email        String      @unique
  fullName     String
  passwordHash String? // null while INVITED
  status       AdminStatus @default(INVITED)
  department   String? // e.g. "Finance", "Compliance"
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  roles                  AdminUserRole[]
  auditLogs              AdminAuditLog[]
  loginEvents            AdminLoginEvent[]
  assignedDisputes       Dispute[]            @relation("DisputeAssignee")
  disputeEvents          DisputeEvent[]
  disputeMessages        DisputeMessage[]
  impersonationRequests  ImpersonationGrant[] @relation("ImpRequester")
  impersonationApprovals ImpersonationGrant[] @relation("ImpApprover")

  @@index([status])
}

enum ImpersonationMode {
  READ // view-as, read-only
  WRITE // act-as — requires a second admin's approval
}

enum ImpersonationStatus {
  PENDING
  APPROVED
  REJECTED
  CONSUMED
  EXPIRED
}

// Impersonating a user in WRITE mode requires a second admin's approval — the
// requester can never approve their own grant. Both IDs are recorded, so
// internal fraud needs collusion, not one compromised account.
model ImpersonationGrant {
  id            String              @id @default(cuid())
  requestedById String
  requestedBy   AdminUser           @relation("ImpRequester", fields: [requestedById], references: [id])
  targetUserId  String
  targetUser    User                @relation(fields: [targetUserId], references: [id])
  mode          ImpersonationMode
  reason        String
  status        ImpersonationStatus @default(PENDING)
  approvedById  String?
  approvedBy    AdminUser?          @relation("ImpApprover", fields: [approvedById], references: [id])
  createdAt     DateTime            @default(now())
  decidedAt     DateTime?
  consumedAt    DateTime? // when the session was started
  expiresAt     DateTime? // session validity window (set on consume)

  @@index([status])
  @@index([targetUserId])
  @@index([requestedById])
}

model AdminUserRole {
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())

  @@id([adminUserId, roleId])
  @@index([roleId])
}

// Append-only. No updatedAt, and the app never issues UPDATE/DELETE against it.
// Production hardening: grant the app's DB role INSERT/SELECT only on this table.
model AdminAuditLog {
  id            String     @id @default(cuid())
  adminUserId   String?
  adminUser     AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action        String // e.g. "user.suspend"
  resource      String // e.g. "User"
  resourceId    String?
  ip            String?
  device        String?
  previousValue Json?
  newValue      Json?
  createdAt     DateTime   @default(now())

  @@index([adminUserId, createdAt])
  @@index([resource, resourceId])
}

model AdminLoginEvent {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  ip          String?
  device      String?
  success     Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([adminUserId, createdAt])
}

// --- Disputes ---

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  WAITING_FOR_USER
  ESCALATED
  RESOLVED
  CLOSED
}

enum DisputePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Dispute {
  id              String          @id @default(cuid())
  code            String          @unique // human ref, e.g. "DSP-1024"
  reporterId      String
  reporter        User            @relation("DisputeReporter", fields: [reporterId], references: [id])
  defendantId     String?
  defendant       User?           @relation("DisputeDefendant", fields: [defendantId], references: [id])
  subjectType     String? // "job" | "loan" | "transaction"
  subjectId       String?
  title           String
  priority        DisputePriority @default(MEDIUM)
  status          DisputeStatus   @default(OPEN)
  assignedAdminId String?
  assignedAdmin   AdminUser?      @relation("DisputeAssignee", fields: [assignedAdminId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  resolvedAt      DateTime?

  events   DisputeEvent[]
  messages DisputeMessage[]
  evidence DisputeEvidence[]

  @@index([status, priority])
  @@index([assignedAdminId])
}

// Immutable timeline entries: status changes, assignments, escalations, notes.
model DisputeEvent {
  id          String         @id @default(cuid())
  disputeId   String
  dispute     Dispute        @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  adminUserId String?
  adminUser   AdminUser?     @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  type        String // "created" | "status_change" | "assigned" | "escalated" | "note"
  note        String?
  fromStatus  DisputeStatus?
  toStatus    DisputeStatus?
  createdAt   DateTime       @default(now())

  @@index([disputeId, createdAt])
}

model DisputeMessage {
  id          String     @id @default(cuid())
  disputeId   String
  dispute     Dispute    @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorType  String // "ADMIN" | "USER"
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  body        String
  isInternal  Boolean    @default(false) // internal notes vs user-visible
  createdAt   DateTime   @default(now())

  @@index([disputeId, createdAt])
}

model DisputeEvidence {
  id        String   @id @default(cuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  label     String
  url       String
  createdAt DateTime @default(now())

  @@index([disputeId])
}

// ============================================================================
// Notifications
// A channel-agnostic engine: one Notification row per (recipient, channel).
// INAPP rows double as the in-app feed; external-channel rows are the durable
// outbox + delivery log. Content comes from admin-editable NotificationTemplate
// rows (with a code/i18n fallback); routing comes from NotificationPreference +
// NotificationSetting. Push (PushDevice) is modeled now, wired in a later stage.
// ============================================================================

enum NotificationChannel {
  INAPP
  EMAIL
  SMS
  WHATSAPP
  IVR
  PUSH
}

enum NotificationCategory {
  SECURITY // OTP, login, account status — always sent, never mutable
  TRANSACTIONAL // payouts, escrow, loans — always sent, never mutable
  ACTIVITY // dispute replies, job offers, attendance, score — mutable
  MARKETING // nudges, promotions — mutable, opt-in
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
  SUPPRESSED
}

model Notification {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    NotificationCategory
  eventKey    String // e.g. "dispute.replied"
  channel     NotificationChannel
  language    Language             @default(EN)
  title       String?
  body        String
  data        Json? // structured payload (ids, deep-link targets)
  status      NotificationStatus   @default(PENDING)
  providerRef String?
  error       String?
  attempts    Int                  @default(0)
  dedupeKey   String?
  createdAt   DateTime             @default(now())
  sentAt      DateTime?
  readAt      DateTime?

  @@index([userId, channel, status])
  @@index([userId, createdAt])
  @@index([status])
  @@index([dedupeKey])
}

// Per-user, per-category, per-channel opt in/out. Absent row = the code default
// (derived from category + whether the channel is deliverable for the user).
model NotificationPreference {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  channel   NotificationChannel
  enabled   Boolean
  updatedAt DateTime             @updatedAt

  @@unique([userId, category, channel])
  @@index([userId])
}

// Per-user global switches. muteAll silences mutable categories; quiet hours are
// stored for the (later) deferral scheduler.
model NotificationSetting {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  muteAll    Boolean  @default(false)
  quietStart Int? // hour 0-23, local; null = no quiet hours
  quietEnd   Int?
  updatedAt  DateTime @updatedAt
}

// Admin-editable content per (event, channel, language). Falls back to the EN
// row, then to the code/i18n default when no active template exists.
model NotificationTemplate {
  id               String              @id @default(cuid())
  eventKey         String
  channel          NotificationChannel
  language         Language
  subject          String? // email/push title
  body             String // supports {placeholder} interpolation
  isActive         Boolean             @default(true)
  version          Int                 @default(1)
  updatedByAdminId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([eventKey, channel, language])
  @@index([eventKey])
}

// A registered device for push delivery (Expo/FCM). Push is wired in a later
// stage; the model exists so the engine is channel-complete.
model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String // ios | android | web
  provider   String   @default("expo")
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ============================================================================
// KYC / verification
// A user submits a VerificationRequest (raising their KYC level) with supporting
// documents. Compliance / the verification team review it and approve (bumping
// User.kycLevel) or reject with a reason. Raw BVN/NIN is never stored — only a
// hash — matching the existing User.bvnHash convention.
// ============================================================================

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationDocType {
  BVN
  NIN
  NATIONAL_ID
  DRIVERS_LICENSE
  VOTERS_CARD
  PASSPORT
  UTILITY_BILL
  SELFIE
}

model VerificationRequest {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedLevel    KycLevel // the level the user wants to reach
  status            VerificationStatus @default(PENDING)
  bvnHash           String? // hashed BVN/NIN, never raw
  reviewedByAdminId String?
  decisionReason    String?
  createdAt         DateTime           @default(now())
  decidedAt         DateTime?

  documents VerificationDocument[]

  @@index([status])
  @@index([userId])
}

model VerificationDocument {
  id        String              @id @default(cuid())
  requestId String
  request   VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type      VerificationDocType
  label     String
  url       String
  createdAt DateTime            @default(now())

  @@index([requestId])
}
