# Admin talks to the API server-side only (token stays in an httpOnly cookie).
ADMIN_API_URL=http://localhost:4000/api

# Network allowlist for the whole admin surface, enforced in edge middleware.
# Comma-separated IPs/CIDRs; unset or "*" allows all (dev). Keep in sync with
# the API's ADMIN_IP_ALLOWLIST.
# ADMIN_IP_ALLOWLIST=10.0.0.0/8,203.0.113.5
